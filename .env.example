# Sentry — public DSN (sent to the browser by design)
NEXT_PUBLIC_SENTRY_DSN=
# Sentry — org auth token for source map upload at build time. Secret: Vercel env only, never committed.
SENTRY_AUTH_TOKEN=
# Supabase — project URL and publishable key (public by design; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
